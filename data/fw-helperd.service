[Unit]
Description=fw-helper firmware control daemon
Documentation=https://github.com/Wooloomooloo2/fw-helper
After=dbus.service
Requires=dbus.service
# Ordering only, deliberately no Wants=: if PPD is part of this boot we would rather
# start after it than race it, but we must not be the reason it starts. A machine
# without PPD is a supported configuration (ADR 0005's fallback), and pulling it in
# would change that machine's behaviour just by installing us.
#
# This is ordering, not a guarantee: systemd considers PPD "started" as soon as its
# unit is active, which for a D-Bus-activated service is before it owns its name. The
# daemon adopts PPD on NameOwnerChanged for exactly that reason; this only narrows the
# window.
After=power-profiles-daemon.service

[Service]
Type=dbus
BusName=org.fwhelper.Daemon1
ExecStart=/usr/libexec/fw-helperd
Restart=on-failure
RestartSec=5

# Root is required for energy_uj (0400, PLATYPUS mitigation) and, from M2, for
# writing pwm1 and the powercap constraints. Everything not needed is dropped.
User=root
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete

# sysfs must stay writable from M2 (pwm1, powercap), so ProtectSystem=strict is not
# usable here. ReadWritePaths is deliberately narrow.
ProtectSystem=full
PrivateTmp=yes
PrivateNetwork=yes
#
# /etc/fw-helper is writable because `fw-helperctl profile save` writes a profile
# there. ProtectSystem=full makes /etc read-only, which is worth keeping - this is the
# only path under it we need. The leading `-` means a missing directory is not a
# startup failure, so uninstalling the profile directory cannot stop the daemon.
ReadWritePaths=/sys/class/hwmon /sys/class/powercap /sys/class/power_supply /sys/firmware/acpi
ReadWritePaths=-/etc/fw-helper

# The crash-path fan restore (ADR 0006 point 1). systemd runs ExecStopPost on every
# stop of the unit, including SIGKILL and a segfault, which is exactly the case the
# daemon's own signal and panic handlers cannot cover. It inherits the sandbox above,
# so /sys/class/hwmon is writable to it. Writing pwm1_enable=2 when the EC already
# owns the fan is a no-op, so running it on clean stops costs nothing.
ExecStopPost=/usr/libexec/fw-helper-restore-fan

[Install]
WantedBy=multi-user.target
