[Unit]
Description=fw-helper firmware control daemon
Documentation=https://github.com/Wooloomooloo2/fw-helper
After=dbus.service
Requires=dbus.service
# There is deliberately NO ordering against power-profiles-daemon here, and adding one
# breaks the boot. PPD declares `After=multi-user.target display-manager.target`, and we
# are WantedBy=multi-user.target - so `After=power-profiles-daemon.service` orders us
# after the very target that pulls us in. systemd finds the cycle and breaks it by
# deleting *our* start job:
#
#   multi-user.target: Found ordering cycle on fw-helperd.service/start
#   Found dependency on power-profiles-daemon.service/start
#   Found dependency on multi-user.target/start
#   Job fw-helperd.service/start deleted to break ordering cycle
#
# The daemon then does not run at all, and leaves no trace that says so: the unit sits
# `enabled` and `inactive (dead)`, not failed, with no journal entry under its own name.
# Measured on hardware 2026-09-01, first boot after installing 0.5.0.
#
# Nothing is lost by omitting it. Ordering could never close the race anyway - systemd
# considers a D-Bus-activated PPD "started" before it owns its bus name - which is why
# the daemon adopts PPD on NameOwnerChanged instead. That adoption is the actual fix,
# and this boot is the proof it has to be.

[Service]
Type=dbus
BusName=org.fwhelper.Daemon1
ExecStart=/usr/libexec/fw-helperd
Restart=on-failure
RestartSec=5

# Root is required for energy_uj (0400, PLATYPUS mitigation) and, from M2, for
# writing pwm1 and the powercap constraints. Everything not needed is dropped.
User=root
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

# The one capability granted back, and it is not decoration: without it GPU load is
# silently never published.
#
# Per-client GPU load is read from /proc/<pid>/fdinfo (usage.rs says why the other two
# sources are wrong). Opening the fdinfo of a process we do not own goes through
# ptrace_may_access(PTRACE_MODE_READ_FSCREDS), and for a different uid that needs
# CAP_SYS_PTRACE. Root does not get it for free - the kernel grants root nothing except
# through capabilities, and the empty bounding set above left the daemon uid 0 holding
# exactly none. Every process driving the GPU belongs to the desktop user, so every one
# of those reads failed with EACCES.
#
# Measured 2026-09-20 against the packaged daemon: gpu_mhz arrived on every tick, which
# proves the DRM device itself was found, while gpu_percent was never published once -
# not in the window, the HUD line, or a recorded session. It passed in development only
# because session-bus mode runs as the user, reading the user's own processes.
#
# This is a read-only use: no ptrace(2) call is made, and @debug stays out of the
# syscall filter below. It is still the widest thing in this unit, which is why it is
# the only capability granted and why the bounding set keeps it the only one available.
CapabilityBoundingSet=CAP_SYS_PTRACE
AmbientCapabilities=CAP_SYS_PTRACE
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete

# sysfs must stay writable from M2 (pwm1, powercap), so ProtectSystem=strict is not
# usable here. ReadWritePaths is deliberately narrow.
ProtectSystem=full
PrivateTmp=yes

# /run/fw-helper, for the one-line status file an in-game overlay reads. systemd
# creates it on start and removes it on stop, which is the property that matters: a
# stale line outliving the daemon would show a game numbers that stopped being true.
#
# Note what is NOT here. Reading per-engine GPU load could have gone through the xe
# PMU, which needs perf_event_open - a syscall in systemd's @debug group and therefore
# excluded by SystemCallFilter=@system-service below. The load figures are read from
# /proc/<pid>/fdinfo instead precisely so this sandbox does not have to be widened.
RuntimeDirectory=fw-helper
PrivateNetwork=yes
#
# /etc/fw-helper is writable because `fw-helperctl profile save` writes a profile
# there. ProtectSystem=full makes /etc read-only, which is worth keeping - this is the
# only path under it we need. The leading `-` means a missing directory is not a
# startup failure, so uninstalling the profile directory cannot stop the daemon.
ReadWritePaths=/sys/class/hwmon /sys/class/powercap /sys/class/power_supply /sys/firmware/acpi
ReadWritePaths=-/etc/fw-helper

# The crash-path fan restore (ADR 0006 point 1). systemd runs ExecStopPost on every
# stop of the unit, including SIGKILL and a segfault, which is exactly the case the
# daemon's own signal and panic handlers cannot cover. It inherits the sandbox above,
# so /sys/class/hwmon is writable to it. Writing pwm1_enable=2 when the EC already
# owns the fan is a no-op, so running it on clean stops costs nothing.
ExecStopPost=/usr/libexec/fw-helper-restore-fan

[Install]
WantedBy=multi-user.target
