<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>fw-helper</vendor>
  <vendor_url>https://github.com/Wooloomooloo2/fw-helper</vendor_url>

  <action id="org.fwhelper.configure">
    <description>Change fan, power, charge-limit and CPU/GPU tuning settings</description>
    <message>Authentication is required to change Framework laptop hardware settings</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!--
        One action for every hardware setting (ADR 0015), auth_admin_keep: one password
        unlocks the whole window for polkit's retention period. This used to be four
        actions, each retained separately, so a profile switch (power limit and fan)
        raised two dialogs back to back and moving between groups asked again - the
        prompt-fatigue failure auth_admin_keep was chosen to avoid.
      -->
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="org.fwhelper.record">
    <description>Record a monitoring session</description>
    <message>Authentication is required to record a monitoring session</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!--
        yes, not auth_admin_keep. Unlike every other action here this changes no
        hardware; it makes the daemon append to a file under /var/lib/fw-helper.
        The daemon must still be asked, because it is the daemon writing as root,
        but a password dialog on a Record button would be the same mistake the
        other actions above are worded to avoid: a prompt that appears often
        enough to be dismissed without reading.
      -->
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
