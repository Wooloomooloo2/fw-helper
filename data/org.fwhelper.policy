<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>fw-helper</vendor>
  <vendor_url>https://github.com/Wooloomooloo2/fw-helper</vendor_url>

  <action id="org.fwhelper.set-charge-limit">
    <description>Set the battery charge limit</description>
    <message>Authentication is required to change the battery charge limit</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!--
        auth_admin_keep: authenticate once, then the session may adjust freely.
        Prompting on every slider movement would train users to click through.
      -->
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="org.fwhelper.set-fan">
    <description>Control the fan</description>
    <message>Authentication is required to take manual control of the fan</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!--
        Same auth_admin_keep reasoning as the charge limit: a fan control that
        prompts on every adjustment trains people to click through prompts.
        Note this action also governs handing the fan back to the EC. That is the
        safe direction, but it is still someone else's setting being changed.
      -->
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="org.fwhelper.set-power-limit">
    <description>Set the sustained CPU power limit</description>
    <message>Authentication is required to change the CPU power limit</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!--
        Same auth_admin_keep reasoning as the other knobs: a control that prompts on
        every adjustment trains people to click through prompts.
      -->
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="org.fwhelper.record">
    <description>Record a monitoring session</description>
    <message>Authentication is required to record a monitoring session</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!--
        yes, not auth_admin_keep. Unlike every other action here this changes no
        hardware; it makes the daemon append to a file under /var/lib/fw-helper.
        The daemon must still be asked, because it is the daemon writing as root,
        but a password dialog on a Record button would be the same mistake the
        other actions above are worded to avoid: a prompt that appears often
        enough to be dismissed without reading.
      -->
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
